PORT=3003
DATABASE_URL=postgresql://app:app@postgres:5432/order_db
REDIS_URL=redis://redis:6379
PRODUCT_SERVICE_URL=http://product-service:3002

# --- RabbitMQ (event bus — checkout saga: stock reserve/release, payment create/reply) ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Checkout saga reconciliation/dead-letter (dev/test tuning — safe defaults for local use) ---
# Số lần RabbitMQ redeliver 1 message saga tối đa trước khi đẩy vào dead-letter queue. Hạ số này
# xuống thấp (vd 2) để test SAGA_CHAOS_MODE=FORCE_DEAD_LETTER nhanh hơn, không phải chờ lâu.
# → Chỉ ảnh hưởng khi SAGA_CHAOS_MODE=FORCE_DEAD_LETTER; 2 mode STUCK_* không dùng biến này.
SAGA_QUEUE_DELIVERY_LIMIT=10
# Cờ giả lập lỗi saga, chỉ dùng để test (xem saga_chaos_mode trong app/config.py). NONE (mặc
# định) = không ảnh hưởng gì. STUCK_STOCK_RESERVE / STUCK_PAYMENT = bước gửi tương ứng âm thầm
# "thành công" mà không gửi thật, khiến đơn bị kẹt để quan sát log retry/hết lượt thử của
# ReconciliationJob (app/jobs/reconciliation.py).
# → 2 mode này chịu ảnh hưởng bởi chu kỳ chạy job, ngưỡng phát hiện "kẹt" và số lần thử lại tối đa
# — các giá trị này không còn nằm trong .env nữa, mà được quản lý runtime qua bảng
# reconciliation_settings (chỉnh trong admin panel, tab "Cài đặt", hoặc API
# GET/PUT /api/v1/admin/saga-settings).
# FORCE_DEAD_LETTER = mọi sự kiện saga trả về đều xử lý thất bại cho tới khi bị đẩy vào
# dead-letter queue. → Mode này chịu ảnh hưởng bởi SAGA_QUEUE_DELIVERY_LIMIT ở trên (không liên
# quan reconciliation_settings, vì nó không đi qua ReconciliationJob).
# Nhớ đổi lại NONE và restart order-service sau khi test xong.
SAGA_CHAOS_MODE=NONE
