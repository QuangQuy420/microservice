PORT=3002
DATABASE_URL=postgresql://app:app@postgres:5432/product_db

# --- MinIO (S3-compatible object storage, shared with face-processing-service) ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PRODUCT_IMAGES=product-images
MINIO_PUBLIC_URL=http://localhost:9000

# --- RabbitMQ (event bus — product.updated/product.deleted publish) ---
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Max redeliveries for a nacked-and-requeued order-saga-events message before RabbitMQ
# routes it to the shared order-saga-events.dlx dead-letter exchange (quorum queue
# x-delivery-limit). Optional — defaults to 10 if unset.
SAGA_QUEUE_DELIVERY_LIMIT=10
