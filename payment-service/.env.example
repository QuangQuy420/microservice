PORT=3004
DATABASE_URL=postgresql://app:app@postgres:5432/payment_db

# --- RabbitMQ (event bus — payment.create.requested in, payment.completed/payment.failed out) ---
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
# Max redeliveries (quorum queue's x-delivery-limit) before a saga message lands in the
# shared order-saga-events.dlq instead of being redelivered forever — same value across
# order-service/product-service/payment-service.
SAGA_QUEUE_DELIVERY_LIMIT=10

# --- Mock card-payment rule (FR1): "CARD" succeeds at/above this amount (VND), fails below it ---
PAYMENT_MIN_CARD_AMOUNT=1000000
