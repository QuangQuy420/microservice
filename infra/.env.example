# ============================================================================
# Central environment for `docker-compose up` (LOCAL only).
# Copy to .env and adjust. Never commit the real .env.
# ============================================================================

# --- Shared ---
JWT_SECRET=change-me-in-.env

# --- PostgreSQL (one server, database-per-service) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
# Databases created on first boot by scripts/init-multiple-dbs.sh
POSTGRES_MULTIPLE_DATABASES=auth_db,product_db,order_db,payment_db,face_processing_db

# --- Redis ---
# (no auth in local dev)

# --- MinIO (S3-compatible object storage for face images and product images) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
FACE_S3_BUCKET=face-images
# Origin(s) allowed to load MinIO objects cross-origin from the browser (canvas/WebGL overlay
# in `web`, e.g. img.crossOrigin = "anonymous"). Comma-separated if multiple.
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:3000

# --- RabbitMQ (event bus, local dev only) ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Public ports (host) ---
API_GATEWAY_PORT=8080
WEB_PORT=3000
